# =============================================================================
# node-red-mcp environment config
#
# Pick ONE profile below and fill in its variables. Don't mix Profile 1 and
# Profile 2 values in the same .env — MCP_PUBLIC_HOST/PORT must match whichever
# docker-compose file you actually run.
# =============================================================================
# Generating this Interactively is reccomended, to avoid secrets being kept in.env files
# Node-RED Admin API token. Used by both profiles.
# Leave blank if Node-RED has no auth configured.
# Generate interactively (prompts for URL/user/password; nothing stored in scripts):
#   ./scripts/auth-token-getter.sh          # Linux/macOS
#   pwsh ./scripts/auth-token-getter.ps1    # Windows
NODE_RED_TOKEN=

# -----------------------------------------------------------------------------
# PROFILE 1: Production (Linux macvlan) — recommended
#   docker compose -f docker-compose.macvlan.yml up -d --build
#
# Container gets its own static LAN IP; clients connect directly, so the IP
# allowlist sees real LAN addresses. Requires a Linux Docker host — macvlan
# does not work on Docker Desktop (Windows/Mac).
# -----------------------------------------------------------------------------

# Node-RED URL reachable FROM the container: its own LAN IP/port, or a
# container DNS name if you attach node-red-net (see below).
NODE_RED_URL=http://192.168.1.10:1880

# Host NIC to attach to. Find it with:
#   ip -br link
MACVLAN_PARENT=eth0

# LAN subnet and gateway — must match your actual network.
MACVLAN_SUBNET=192.168.1.0/24
MACVLAN_GATEWAY=192.168.1.1
# Unused static IP for this container. 
MACVLAN_IP=192.168.1.50

# Shown in startup logs and the settings UI. Must match MACVLAN_IP
# (or a DNS name that resolves to it).
MCP_PUBLIC_HOST=192.168.1.50
MCP_PUBLIC_PORT=3000

# Optional: attach to Node-RED's existing user-defined Docker network
# (NOT the default "bridge") for container-name DNS instead of a LAN IP/URL.
#   1. Find the network:  docker network ls
#   2. Set its name:      DOCKER_NETWORK=nodered_default
#   3. Uncomment the `node-red-net` network block in docker-compose.macvlan.yml
#      and add it under the service's `networks:` list.
#   4. Point NODE_RED_URL at the service name instead:
#      NODE_RED_URL=http://nodered:1880
# DOCKER_NETWORK=nodered_default

# -----------------------------------------------------------------------------
# PROFILE 2: Local / Docker Desktop (development only)
#   docker compose up -d --build
#
# Peer IP seen by the container is the Docker gateway (172.x), not a real LAN
# address — fine for local testing, not for LAN-wide IP allowlisting.
#
# To use this profile: comment out all of PROFILE 1 above, then uncomment
# the three lines below.
# -----------------------------------------------------------------------------

# NODE_RED_URL=http://host.docker.internal:1880
# MCP_PUBLIC_HOST=127.0.0.1
# MCP_PUBLIC_PORT=3001

# -----------------------------------------------------------------------------
# Optional (either profile)
# -----------------------------------------------------------------------------

# Docker image tag for compose (default: node-red-mcp:2.0.0, built locally).
# When you publish to your GHCR namespace:
# IMAGE_NAME=ghcr.io/adub08/node-red-mcp:2.0.0

# Encrypt Node-RED token at rest in /data/config.json (AES-256-GCM).
# Generate once and keep safe — lose this key and you must re-enter the token:
#   openssl rand -base64 32
# Prefer setting the token in the Admin UI after this is configured, so it is
# never written plaintext to config.json. NODE_RED_TOKEN in .env is only used
# to seed first boot (then migrated to encrypted form on save).
# NR_MCP_ENCRYPTION_KEY=

# Container's internal listen port, if you need something other than 3000.
# MCP_HTTP_PORT=3000

# Cloudflare Access JWT validation at origin.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=
